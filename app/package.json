{
  "name": "@rzl-nexos/app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "electron:start": "cross-env NODE_ENV=development electron .",
    "electron:dev": "concurrently -k \"cross-env BROWSER=none vite\" \"wait-on tcp:5176 && electron .\"",
    "electron:build": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.rzlapps.nexos",
    "productName": "Nexos",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  },
  "dependencies": {
    "solid-js": "^1.9.11"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "42.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.8.2",
    "vite": "^8.0.1",
    "vite-plugin-solid": "^2.11.11",
    "wait-on": "^9.0.10"
  }
}

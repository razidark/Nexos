generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = "sqlserver://localhost:1433;database=nexos_db;integratedSecurity=true;trustServerCertificate=true;"
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  avatar       String    @default("solar")
  status       String    @default("online")
  customStatus String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  
  messages     Message[]
  guilds       Guild[]   @relation("GuildOwner")
}

model Guild {
  id        String    @id @default(cuid())
  name      String
  icon      String    @default("🪐")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  ownerId   String?
  owner     User?     @relation("GuildOwner", fields: [ownerId], references: [id])
  
  channels  Channel[]
}

model Channel {
  id        String    @id @default(cuid())
  name      String
  type      String    @default("text") // "text" or "voice"
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  guildId   String
  guild     Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)

  messages  Message[]
}

model Message {
  id          String   @id @default(cuid())
  text        String   @db.Text
  timestamp   BigInt
  createdAt   DateTime @default(now())
  
  senderId    String
  sender      User     @relation(fields: [senderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  
  channelId   String
  channel     Channel? @relation(fields: [channelId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  attachments String?  @db.NVarChar(Max)  // JSON array string
  reactions   String?  @db.NVarChar(Max)  // JSON array string
  replyToId   String?  // The ID of the message this is replying to
}
